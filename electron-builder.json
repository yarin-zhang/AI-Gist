{
    "appId": "com.yarinz.aigist",
    "productName": "AI Gist",
    "directories": {
        "output": "dist",
        "buildResources": "resources"
    },
    "publish": {
        "provider": "github",
        "owner": "yarin-zhang",
        "repo": "AI-Gist",
        "releaseType": "draft"
    },    "files": [
        {
            "from": "build/main",
            "to": "./main",
            "filter": [
                "**/*"
            ]
        },
        {
            "from": "build/renderer",
            "to": "./renderer",
            "filter": [
                "**/*"
            ]
        },
        {
            "from": "build/shared",
            "to": "./shared",
            "filter": [
                "**/*"
            ]
        },
        {
            "from": "src/assets",
            "to": "./assets",
            "filter": [
                "*.png",
                "*.ico",
                "*.icns"
            ]
        },
        "package.json",
        "!node_modules/@capacitor/android/**",
        "!node_modules/@capacitor/ios/**",
        "!node_modules/@capacitor/*/android/**",
        "!node_modules/@capacitor/*/ios/**"
    ],
    "asarUnpack": [],
    "extraResources": [],
    "nsis": {
        "oneClick": false,
        "perMachine": false,
        "allowToChangeInstallationDirectory": true,
        "shortcutName": "AI Gist",
        "installerIcon": "src/assets/windows.ico",
        "uninstallerIcon": "src/assets/windows.ico"
    },
    "win": {
        "target": "nsis",
        "icon": "src/assets/windows.ico",
        "artifactName": "AI-Gist-${version}-Windows-Setup.${ext}"
    },
    "appx": {
        "applicationId": "AIGist",
        "identityName": "YarinZ.AIGist-PromptManager",
        "publisher": "CN=B0E00209-75E9-44EE-B4B3-F71D2E3B4634",
        "publisherDisplayName": "Yarin Z",
        "displayName": "AI Gist",
        "backgroundColor": "#1E293B",
        "languages": [
            "zh-CN",
            "en-US"
        ],
        "artifactName": "AI-Gist-${version}-Windows-Store-${arch}.${ext}"
    },
    "mac": {
        "target": "dmg",
        "icon": "src/assets/macos.icns",
        "artifactName": "AI-Gist-${version}-macOS-${arch}.${ext}",
        "hardenedRuntime": true,
        "entitlements": "resources/entitlements.mac.plist",
        "entitlementsInherit": "resources/entitlements.mac.plist"
    },
    "mas": {
        "appId": "com.getaigist.app",
        "target": "mas",
        "icon": "src/assets/macos.icns",
        "artifactName": "AI-Gist-${version}-Mac-App-Store-${arch}.${ext}",
        "hardenedRuntime": true,
        "mergeASARs": false,
        "entitlements": "resources/entitlements.mas.plist",
        "entitlementsInherit": "resources/entitlements.mas.inherit.plist"
    },
    "dmg": {
        "background": "src/assets/dmg-background.png",
        "contents": [
            {
                "x": 140,
                "y": 180,
                "type": "file"
            },
            {
                "x": 400,
                "y": 180,
                "type": "link",
                "path": "/Applications"
            },
            {
                "x": 270,
                "y": 320,
                "type": "file",
                "path": "src/assets/安装说明.html"
            }
        ],
        "window": {
            "width": 540,
            "height": 480
        },
        "title": "AI Gist ${version}"
    },
    "linux": {
        "target": [
            "AppImage"
        ],
        "icon": "src/assets/linux.png",
        "artifactName": "AI-Gist-${version}-linux.${ext}"
    }
}
