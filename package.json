{
    "name": "ai-gist",
    "version": "2.1.0",
    "description": "本地优先的 AI 提示词管理工具，能够管理 AI 提示词 + 变量填充 + 分类标签。",
    "main": "./main/main.js",
    "bin": "./bin/ai-gist.js",
    "scripts": {
        "dev": "node scripts/dev-server.js",
        "dev:win": "node scripts/dev-server.js --windows",
        "dev:web": "vite --config config/vite.config.web.js",
        "build": "node scripts/build.js && electron-builder --config config/electron-builder.json",
        "build:win": "node scripts/build.js && electron-builder --config config/electron-builder.json --win",
        "build:store:win": "node scripts/build.js && electron-builder --config config/electron-builder.json --win appx --x64 --arm64 --publish never",
        "build:mac": "node scripts/build.js && PYTHON=python3 npm_config_python=python3 electron-builder --config config/electron-builder.json --mac",
        "build:store:mac": "node scripts/build.js && PYTHON=python3 npm_config_python=python3 electron-builder --config config/electron-builder.mas.js --mac --universal --publish never",
        "build:linux": "node scripts/build.js && electron-builder --config config/electron-builder.json --linux",
        "build:store:linux": "node scripts/build.js && electron-builder --config config/electron-builder.snap.js --linux snap --x64 --publish never",
        "build:web": "vite build --config config/vite.config.web.js",
        "serve:web": "node scripts/web-server.js",
        "build:ci:mac": "node scripts/build.js && CSC_IDENTITY_AUTO_DISCOVERY=false yarn electron-builder --config config/electron-builder.json --mac",
        "build:ci:win": "node scripts/build.js && yarn electron-builder --config config/electron-builder.json --win",
        "build:ci:linux": "node scripts/build.js && yarn electron-builder --config config/electron-builder.json --linux",
        "build:mobile": "node scripts/build-mobile.js",
        "preview:web": "vite preview --config config/vite.config.web.js",
        "cap:assets": "npx @capacitor/assets generate",
        "cap:sync": "cap sync",
        "cap:ios": "cap open ios",
        "cap:android": "cap open android",
        "lint": "eslint --config config/eslint.config.mjs .",
        "lint:fix": "eslint --config config/eslint.config.mjs . --fix",
        "test": "vitest --config config/vitest.config.ts",
        "test:run": "vitest run --config config/vitest.config.ts",
        "test:ui": "vitest --ui --config config/vitest.config.ts",
        "test:coverage": "vitest run --coverage --config config/vitest.config.ts",
        "version": "git add -A",
        "postversion": "git push && git push --tags"
    },
    "repository": "https://github.com/yarin-zhang/ai-gist",
    "author": {
        "name": "Yarin Zhang",
        "url": "https://github.com/yarin-zhang"
    },
    "devDependencies": {
        "@anthropic-ai/sdk": "^0.53.0",
        "@capacitor/android": "^8.1.0",
        "@capacitor/app": "^8.0.1",
        "@capacitor/assets": "^3.0.5",
        "@capacitor/camera": "^8.0.2",
        "@capacitor/cli": "^8.1.0",
        "@capacitor/core": "^8.1.0",
        "@capacitor/filesystem": "^8.1.2",
        "@capacitor/ios": "^8.1.0",
        "@capacitor/preferences": "^8.0.1",
        "@capacitor/share": "^8.0.1",
        "@capacitor/splash-screen": "^8.0.1",
        "@codemirror/autocomplete": "^6.20.3",
        "@codemirror/commands": "^6.10.4",
        "@codemirror/state": "^6.7.1",
        "@codemirror/view": "^6.43.6",
        "@electron/get": "^2.0.0",
        "@eslint/js": "^9.29.0",
        "@google/generative-ai": "^0.24.1",
        "@ionic/vue": "^8.0.0",
        "@ionic/vue-router": "^8.0.0",
        "@langchain/google-genai": "^0.2.10",
        "@types/nunjucks": "^3.2.6",
        "@types/uuid": "^10.0.0",
        "@typescript-eslint/eslint-plugin": "^8.35.0",
        "@typescript-eslint/parser": "^8.35.0",
        "@vicons/tabler": "^0.13.0",
        "@vitejs/plugin-vue": "^4.4.1",
        "@vitest/coverage-v8": "~3.1.0",
        "@vitest/ui": "~3.1.0",
        "@vue/eslint-config-typescript": "^14.5.1",
        "@vue/tsconfig": "^0.7.0",
        "archiver": "^7.0.1",
        "chalk": "^4.1.2",
        "chokidar": "^4.0.3",
        "commander": "^15.0.0",
        "electron": "^32.1.2",
        "electron-builder": "^25.1.6",
        "eslint": "^9.29.0",
        "eslint-plugin-vue": "^10.2.0",
        "fake-indexeddb": "^6.2.5",
        "fast-check": "^4.9.0",
        "ionicons": "^7.0.0",
        "jsdom": "^24.1.0",
        "langchain": "^0.3.27",
        "naive-ui": "^2.41.0",
        "nunjucks": "^3.2.4",
        "sass": "^1.89.2",
        "tailwindcss": "^4.1.11",
        "tsc-alias": "^1.8.16",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.35.0",
        "unzipper": "^0.12.3",
        "vite": "^6.3.5",
        "vitest": "~3.1.0",
        "vue": "^3.3.8",
        "vue-eslint-parser": "^10.1.4",
        "vue-i18n": "9",
        "vue-router": "^4.0.0",
        "zod": "^3.25.40"
    },
    "dependencies": {
        "@langchain/anthropic": "^0.3.21",
        "@langchain/core": "^0.3.57",
        "@langchain/ollama": "^0.2.1",
        "@langchain/openai": "^0.5.12",
        "uuid": "^11.1.0",
        "webdav": "^5.5.0"
    },
    "packageManager": "yarn@4.9.2"
}
